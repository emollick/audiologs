# Copy to .env and fill in. Never commit .env.

# Claude writes the station bible, the audio log scripts and the voice casting.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ElevenLabs voices the logs and generates the sound effects.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_v4

# Optional: pull tickets straight from JIRA Cloud with --jql
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
